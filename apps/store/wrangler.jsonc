{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "maya-organics-store",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // Test address until launch; kept out of search engines (X-Robots-Tag, see middleware + public/_headers).
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maya-organics-db",
      "database_id": "6ec67a80-ee27-46d5-8ad0-9fa0654f019e",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "images": { "binding": "IMAGES" },
  // WhatsApp bot: new-order alerts and login codes (POST with the shared LEAD_SECRET).
  "services": [{ "binding": "BOT", "service": "mayaorganics-whatsapp" }],
  // Login attempts per IP (Workers Rate Limiting; period must be 10 or 60 s).
  "ratelimits": [{ "name": "LOGIN_LIMIT", "namespace_id": "1101", "simple": { "limit": 6, "period": 60 } }],
  "vars": {
    "WHATSAPP_NUMBER": "917680945577",
    // Turnstile site key (public). Test key until the real widget exists; secret: TURNSTILE_SECRET.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    // Typed-code logins we can send ("whatsapp_code", "sms"); empty = WhatsApp login only.
    "LOGIN_CODE_CHANNELS": ""
  },
  // Secrets (wrangler secret put): TURNSTILE_SECRET, LEAD_SECRET (same value as the bot's).
  "observability": { "enabled": true }
}
