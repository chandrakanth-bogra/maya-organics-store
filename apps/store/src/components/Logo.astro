---
// Brand wordmark inlined so its dark green follows the theme (currentColor).
import raw from '../assets/logo.svg?raw';

interface Props { class?: string }
const { class: className = '' } = Astro.props;

const svg = raw
  .replace(/<\?xml[^>]*>/, '')
  .replace(/<!--[\s\S]*?-->/g, '')
  .replace(/\s(width|height)="[^"]*"/g, '')
  .replace(/#006633/g, 'currentColor')
  .replace('<svg', `<svg role="img" aria-label="Maya Organics" class="${className}"`);
---
<Fragment set:html={svg} />
