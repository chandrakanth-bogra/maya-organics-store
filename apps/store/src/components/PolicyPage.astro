---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import { breadcrumbLd } from '../lib/seo';

interface Props { title: string; description: string; path: string; updated: string }
const { title, description, path, updated } = Astro.props;
const crumbs = [{ name: 'Home', path: '/' }, { name: title, path }];
---
<BaseLayout title={title} description={description} jsonLd={[breadcrumbLd(crumbs)]}>
  <article class="container-page py-12 md:py-16">
    <Breadcrumbs items={crumbs} />
    <div class="mx-auto max-w-3xl">
      <h1>{title}</h1>
      <p class="mt-3 text-sm text-muted-foreground">Last updated: {updated}</p>
      <div class="prose-maya mt-8">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>
