---
interface Props { items: { name: string; path: string }[] }
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="mb-6 text-sm text-muted-foreground">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    {items.map((it, i) => (
      <li class="flex items-center gap-2">
        {i > 0 && <span aria-hidden="true">/</span>}
        {i === items.length - 1
          ? <span aria-current="page" class="text-foreground">{it.name}</span>
          : <a href={it.path} class="hover:text-foreground">{it.name}</a>}
      </li>
    ))}
  </ol>
</nav>
