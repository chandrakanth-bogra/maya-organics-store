---
import { SITE, whatsappLink } from '../lib/site';

const year = new Date().getFullYear();
const shop = [
  ['Perlite', '/products/perlite'],
  ['Pumice', '/products/pumice'],
  ['LECA', '/products/leca'],
  ['Pine Bark', '/products/pine-bark'],
  ['All products', '/products'],
];
const help = [
  ['Guides', '/guides'],
  ['Shipping', '/shipping'],
  ['Returns', '/returns'],
  ['Privacy', '/privacy'],
  ['Terms', '/terms'],
];
---
<footer class="bg-footer text-footer-foreground">
  <div class="container-page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr_1.2fr]">
    <div>
      <p class="font-heading text-2xl text-white">{SITE.name}</p>
      <p class="mt-3 max-w-xs text-sm leading-relaxed">{SITE.description}</p>
    </div>
    <nav aria-label="Shop">
      <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-white">Shop</p>
      <ul class="space-y-2 text-sm">{shop.map(([l, h]) => <li><a class="hover:text-white" href={h}>{l}</a></li>)}</ul>
    </nav>
    <nav aria-label="Help">
      <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-white">Help</p>
      <ul class="space-y-2 text-sm">{help.map(([l, h]) => <li><a class="hover:text-white" href={h}>{l}</a></li>)}</ul>
    </nav>
    <div class="text-sm">
      <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-white">Contact</p>
      <ul class="space-y-2">
        <li><a class="hover:text-white" href={whatsappLink()}>WhatsApp {SITE.phoneDisplay}</a></li>
        <li><a class="hover:text-white" href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li>{SITE.locality}, {SITE.region}</li>
        <li><a class="hover:text-white" href={SITE.b2bUrl}>Bulk &amp; B2B orders →</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <p class="container-page py-5 text-xs">© {year} {SITE.name}. Retail prices include GST.</p>
  </div>
</footer>
