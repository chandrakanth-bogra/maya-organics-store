---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { loadCatalogue } from '../../lib/catalogue';
import { breadcrumbLd, itemListLd } from '../../lib/seo';

const products = await loadCatalogue();
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Shop', path: '/products' }];
Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=300');
---
<BaseLayout
  title="Shop Soil Amendments & Growing Media"
  description="Buy perlite, pumice, LECA, pine bark, vermiculite, cocopeat, vermicompost, zeolite and neem cake online in India. Prices include GST."
  jsonLd={[itemListLd(products), breadcrumbLd(crumbs)]}
>
  <section class="container-page py-12 md:py-16">
    <Breadcrumbs items={crumbs} />
    <span class="eyebrow">All products</span>
    <h1>Soil amendments &amp; growing media</h1>
    <p class="mt-4 max-w-2xl text-muted-foreground">Everything for a well-draining, healthy potting mix. Prices include GST.</p>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {products.map((p, i) => <ProductCard product={p} eager={i < 3} />)}
    </div>
  </section>
</BaseLayout>
